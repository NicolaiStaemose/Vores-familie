@page "/"
@inherits SessionComponent
@inject NavigationManager Nav

@if (!Session.IsSignedIn)
{
    <Login />
}
else if (Session.Family is null)
{
    <CreateFamily />
}
else
{
    <h1>Hej @Session.Family.Me.DisplayName 👋</h1>
    <p>Velkommen til <strong>@Session.Family.Name</strong>. Din rolle: @Session.RoleName(Session.Family.Me.Role).</p>
    <div class="row wrap">
        <a class="button primary" href="min-side">Min side</a>
        <a class="button primary" href="kalender">Kalender</a>
        <a class="button primary" href="lektier">Lektier</a>
    </div>
    <p class="muted">Rutiner, madplan og meget mere kommer i de næste faser.</p>
}

