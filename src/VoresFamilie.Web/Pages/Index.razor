@page "/"
@inherits SessionComponent
@inject NavigationManager Nav

@if (!Session.IsSignedIn)
{
    <Login />
}
else if (Session.Family is null)
{
    <CreateFamily />
}
else
{
    <h1>Hej @Session.Family.Me.DisplayName 👋</h1>
    <p class="muted">@Session.Family.Name · @Session.RoleName(Session.Family.Me.Role)</p>
    <div class="tiles">
        <a class="tile" href="min-side"><span class="tile-icon">🏠</span>Min side</a>
        <a class="tile" href="kalender"><span class="tile-icon">📅</span>Kalender</a>
        <a class="tile" href="lektier"><span class="tile-icon">📚</span>Lektier</a>
        <a class="tile" href="todo"><span class="tile-icon">✅</span>ToDo</a>
        <a class="tile" href="madplan"><span class="tile-icon">🍽️</span>Madplan</a>
        <a class="tile" href="indkob"><span class="tile-icon">🛒</span>Indkøb</a>
        <a class="tile" href="rengoring"><span class="tile-icon">🧹</span>Rengøring</a>
    </div>
    <p class="muted">Notifikationer og offline-brug kommer i næste fase.</p>
}

@code {
}






