@page "/"
@inherits SessionComponent
@inject NavigationManager Nav

@if (!Session.IsSignedIn)
{
    <Login />
}
else if (Session.Family is null)
{
    <CreateFamily />
}
else
{
    <h1>Hej @Session.Family.Me.DisplayName 👋</h1>
    <p>Velkommen til <strong>@Session.Family.Name</strong>. Din rolle: @Session.RoleName(Session.Family.Me.Role).</p>
    <div class="row wrap">
        <a class="button primary" href="min-side">Min side</a>
        <a class="button primary" href="kalender">Kalender</a>
        <a class="button primary" href="lektier">Lektier</a>
        <a class="button primary" href="todo">ToDo</a>
        <a class="button primary" href="madplan">Madplan</a>
        <a class="button primary" href="indkob">Indkøb</a>
        <a class="button primary" href="rengoring">Rengøring</a>
    </div>
    <p class="muted">Notifikationer og offline-brug kommer i næste fase.</p>
}

@code {
}






