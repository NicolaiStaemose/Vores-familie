@implements IDisposable
@inject Pwa Pwa
@inject Session Session
@inject ShoppingOffline Shopping

@if (!Pwa.Online || Session.Offline)
{
    <div class="statusbar offline" role="status">
        <span>📡 Du er offline. Du ser den gemte udgave@(PendingText).</span>
    </div>
}
else if (Shopping.Pending > 0)
{
    <div class="statusbar offline" role="status">
        <span>Sender @Shopping.Pending ændring@(Shopping.Pending == 1 ? "" : "er") fra indkøbslisten…</span>
    </div>
}
@if (Pwa.UpdateReady)
{
    <div class="statusbar update" role="status">
        <span>Ny version af appen er klar.</span>
        <button class="primary" @onclick="Pwa.ApplyUpdateAsync">Opdatér</button>
    </div>
}

@code {
    private string PendingText => Shopping.Pending > 0
        ? $". {Shopping.Pending} ændring{(Shopping.Pending == 1 ? "" : "er")} sendes, når nettet er tilbage"
        : "";

    protected override void OnInitialized()
    {
        Pwa.Changed += OnChanged;
        Session.Changed += OnChanged;
        Shopping.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Pwa.Changed -= OnChanged;
        Session.Changed -= OnChanged;
        Shopping.Changed -= OnChanged;
    }
}
