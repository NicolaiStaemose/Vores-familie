<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="NSwag.MSBuild" Version="14.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- Building the API refreshes contracts/openapi.json, which the client is generated from (Docker passes SkipApiBuild; it uses the committed contract). -->
  <Target Name="BuildApiContract" BeforeTargets="GenerateApiClient" Condition="'$(SkipApiBuild)' != 'true'">
    <MSBuild Projects="..\VoresFamilie.Api\VoresFamilie.Api.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="GenerateApiClient" BeforeTargets="CoreCompile" Inputs="..\..\contracts\openapi.json;nswag.json" Outputs="Generated\ApiClient.g.cs">
    <Exec Command="$(NSwagExe_Net100) run nswag.json /variables:Configuration=$(Configuration)" />
    <!-- Include the file even when it did not exist at evaluation time (fresh clone). -->
    <ItemGroup>
      <Compile Remove="Generated\ApiClient.g.cs" />
      <Compile Include="Generated\ApiClient.g.cs" />
    </ItemGroup>
  </Target>

</Project>




