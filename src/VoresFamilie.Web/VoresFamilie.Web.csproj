<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Allows the build-order-only reference to the API (an executable) from this WebAssembly project. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="NSwag.MSBuild" Version="14.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!--
    The client is generated from contracts/openapi.json, which the API build refreshes. A real project reference (build order only,
    no assembly reference) lets MSBuild build the API exactly once and before this project, also in a parallel Rebuild Solution.
    Docker passes SkipApiBuild and uses the committed contract instead.
  -->
  <ItemGroup Condition="'$(SkipApiBuild)' != 'true'">
    <ProjectReference Include="..\VoresFamilie.Api\VoresFamilie.Api.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="GenerateApiClient" BeforeTargets="CoreCompile" Inputs="..\..\contracts\openapi.json;nswag.json" Outputs="Generated\ApiClient.g.cs">
    <Exec Command="$(NSwagExe_Net100) run nswag.json /variables:Configuration=$(Configuration)" />
    <!-- Include the file even when it did not exist at evaluation time (fresh clone). -->
    <ItemGroup>
      <Compile Remove="Generated\ApiClient.g.cs" />
      <Compile Include="Generated\ApiClient.g.cs" />
    </ItemGroup>
  </Target>

</Project>





