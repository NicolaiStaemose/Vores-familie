@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject Emojis Emojis
@inject NavigationManager Nav

<header class="topbar">
    <a class="brand" href="/">Vores familie</a>
    @if (Session.IsSignedIn)
    {
        <nav>
            @if (Session.Family is not null)
            {
                <a href="min-side">Min side</a>
                <a href="kalender">Kalender</a>
                <a href="lektier">Lektier</a>
                <a href="todo">ToDo</a>
                @if (Session.CanEdit(Area.Routines)) { <a href="rutiner">Rutiner</a> }
                <a href="indstillinger/google">Google</a>
            }
            @if (Session.IsAdmin) { <a href="admin">Admin</a> }
            <button class="link" @onclick="LogoutAsync">Log ud</button>
        </nav>
    }
</header>
<main class="content">
    @if (!Session.Loaded) { <p>Henter…</p> } else { @Body }
</main>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += StateHasChanged;
        await Emojis.InitAsync();
        await Session.RefreshAsync();
    }

    private async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: false);
    }

    public void Dispose() => Session.Changed -= StateHasChanged;
}




