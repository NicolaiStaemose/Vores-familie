# Optional Google login (create an OAuth client; redirect URI: http://localhost:8080/api/auth/google-signin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar sync (see docs/google-setup.md). Redirect URI: http://localhost:8080/api/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional: GOOGLE_MODE=Fake runs the calendar features on demo data without Google.
GOOGLE_MODE=
